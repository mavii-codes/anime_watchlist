# Port the API listens on
PORT=3001

# PostgreSQL connection string — replace user, password, host, port and dbname
# with your own database credentials.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secret used to sign JWTs — generate a strong random value, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_string

# JWT lifetime (e.g. 7d, 12h, 60m)
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173
